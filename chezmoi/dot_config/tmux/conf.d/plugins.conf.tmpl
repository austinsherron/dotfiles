# vim: set filetype=tmux :

## inventory ###################################################################

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'Morantron/tmux-fingers'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-open'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'srcery-colors/srcery-tmux'
set -g @plugin 'hiroppy/tmux-agent-sidebar'
# NOTE: this needs to be last; see https://github.com/tmux-plugins/tmux-continuum#known-issues
set -g @plugin 'tmux-plugins/tmux-continuum'

## conf ########################################################################

# theme ####################################################

set -g @srcery_tmux_patched_font '1'

# session persistence ######################################

# set persistence storage dir
set -g @resurrect-dir "{{ print (env "TMUX_ROOT_PUB") "/resurrect" }}"

# enable automatic session saving and persistence
set -g @continuum-restore 'on'
set -g @resurrect-capture-pane-contents 'on'

# enable and configure tmux auto-boot
set -g @continuum-boot 'on'
set -g @continuum-boot-options 'fullscreen'

# agent sidebar ############################################

# NOTE: these must be set before tpm runs, below: tmux-agent-sidebar's entry
# script sources its own agent-sidebar.conf, which reads them at that point

# the plugin's default toggle key, "e", is already bound to a pane resize (see:
# conf.d/keymap/pane.conf), and plugins load after conf.d/keymap.conf, so the
# plugin would silently win. "a" (agent) is free; "A" toggles every window
set -g @sidebar_key 'a'
set -g @sidebar_key_all 'A'

# don't spawn a sidebar into every new window: it adds a pane the stashed
# layouts don't account for (see: tmux-resize-layouts, tmux-stack)
set -g @sidebar_auto_create 'off'

# misc #####################################################

# skip tmux-fingers setup
set -g @fingers-skip-wizard 1

## install #####################################################################

# initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run "{{ print (env "TMUX_ROOT_PUB") "/plugins/tpm/tpm" }}"

## post install ################################################################

# workaround for initializing tmux-continuum w/ tmux 3.6+ (see script for details)
run "{{ print (env "TMUX_ROOT_PUB") "/scripts/init-continuum.sh" }}"

# the plugin's toggle doesn't preserve the window layout, so point its keys at
# the wrapper that does (see script for details)
#
# NOTE: these override bindings the plugin registers for itself, so they have to
# come after the tpm run above -- that's what sources its agent-sidebar.conf --
# and the keys have to stay in sync with @sidebar_key/@sidebar_key_all
bind-key a run-shell "{{ print (env "TMUX_ROOT_PUB") "/scripts/agent-sidebar-toggle.sh" }} toggle '#{window_id}' '#{pane_current_path}'"
bind-key A run-shell "{{ print (env "TMUX_ROOT_PUB") "/scripts/agent-sidebar-toggle.sh" }} toggle-all"
