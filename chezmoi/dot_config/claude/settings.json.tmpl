      "mcp__plugin_maybern-monitoring_datadog__search_datadog_services",
      "mcp__plugin_maybern-monitoring_datadog__search_datadog_spans",
      "Read(//Users/austin/.claude/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
        "{{ print (env "CODE_ROOT") }}",
        "{{ print (env "WORK_ROOT") }}"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-terminal -t 🔔 Claude Code -m Please review changes"
          },
          {
            "type": "command",
            "command": "cld-agent-status --state input"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-terminal -t ✅ Claude Code -m Task completed successfully"
          },
          {
            "type": "command",
            "command": "cld-agent-status --state done"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "save-plan",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "hiroppy": {
      "source": {
        "source": "directory",
        "path": "{{ print (env "TMUX_ROOT") "/plugins/tmux-agent-sidebar" }}"
      }
    }
  },
  "enabledPlugins": {
    "maybern-dev@maybern": true,
    "maybern-monitoring@maybern": true,
    "maybern-ticket-lifecycle@maybern": true,
    "pyright-lsp@claude-plugins-official": true,
    "maybern-incident-response@maybern": true,
    "tmux-agent-sidebar@hiroppy": true
  },
  "tui": "fullscreen",
  "model": "opus[1m]"
}
